{
    "methods": {
        "create_market": {
            "argument": "orderbook.create_market_arguments",
            "return": "orderbook.create_market_result",
            "description": "Create a new trading market between two tokens. Permissionless: anyone may list a pair; the transaction payer covers the mana. Both addresses must answer decimals() like a live token contract",
            "entry-point": "0x30231247",
            "read-only": false
        },
        "set_min_base_amount": {
            "argument": "orderbook.set_min_base_amount_arguments",
            "return": "orderbook.set_min_base_amount_result",
            "description": "Adjust a market's minimum order size (contract authority only; repair hatch for unusable permissionless listings)",
            "entry-point": "0xcd1646ad",
            "read-only": false
        },
        "place_order": {
            "argument": "orderbook.place_order_arguments",
            "return": "orderbook.place_order_result",
            "description": "Place a limit order. Crossing orders are matched immediately with price-time priority; any remainder is escrowed on the book (GTC), refunded (IOC) or the call fails (POST_ONLY if it would cross)",
            "entry-point": "0x163b60a5",
            "read-only": false
        },
        "cancel_order": {
            "argument": "orderbook.cancel_order_arguments",
            "return": "orderbook.cancel_order_result",
            "description": "Cancel an open order and refund its escrow (order owner authority)",
            "entry-point": "0x8442359c",
            "read-only": false
        },
        "get_markets": {
            "argument": "orderbook.get_markets_arguments",
            "return": "orderbook.get_markets_result",
            "description": "Get all markets with their stats",
            "entry-point": "0xaf7aee93",
            "read-only": true
        },
        "get_orderbook": {
            "argument": "orderbook.get_orderbook_arguments",
            "return": "orderbook.get_orderbook_result",
            "description": "Get the resting orders of a market orderbook, best priced first",
            "entry-point": "0x453f3fab",
            "read-only": true
        },
        "get_order": {
            "argument": "orderbook.get_order_arguments",
            "return": "orderbook.get_order_result",
            "description": "Get a single open order by id",
            "entry-point": "0x45915cb9",
            "read-only": true
        },
        "get_user_orders": {
            "argument": "orderbook.get_user_orders_arguments",
            "return": "orderbook.get_user_orders_result",
            "description": "Get the open orders of an account, ordered by ascending order id",
            "entry-point": "0x4b436b62",
            "read-only": true
        },
        "get_trades": {
            "argument": "orderbook.get_trades_arguments",
            "return": "orderbook.get_trades_result",
            "description": "Get the most recent trades of a market, newest first",
            "entry-point": "0xb43d6baf",
            "read-only": true
        }
    },
    "types": ""
}