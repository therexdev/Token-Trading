# Build-time settings for app.tradekoinos.com, baked into the static bundle by
# `npm run build`. Trade Koinos ships as static files with NO server of its
# own — Google sign-in and transaction signing happen on usekoinos.com, which
# holds the key and signs on request (the key never reaches the browser).
#
# With none of these set, the app builds Kondor-only and is unchanged.

# Address of the deployed orderbook contract. If unset, the build bakes in the
# live mainnet orderbook (same default the old FTP workflow used).
VITE_ORDERBOOK_ADDRESS=

# Koinos JSON-RPC endpoint and network label.
VITE_KOINOS_RPC=https://api.koinos.io
VITE_KOINOS_NETWORK=mainnet

# usekoinos.com — where Google sign-in and signing happen. Set this to enable
# the "Continue with Google" button; leave it empty to stay Kondor-only.
# The Google client id is served from there (/api/signer-config), so it does
# NOT need to be set here.
VITE_SIGNER_API=https://usekoinos.com
