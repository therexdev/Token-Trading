# Server settings for app.tradekoinos.com (see server/server.js).
# The static build at trade.koinoskit.site needs none of this — without a
# server the app simply stays Kondor-only.

# Port the Node app listens on. Hostinger sets this for you.
PORT=3000

# Aurvania's Google client id. The ID token the browser mints must carry it,
# or Aurvania rejects the sign-in as belonging to a different app. Leave it
# unset to inherit the id from Aurvania at boot.
GOOGLE_CLIENT_ID=

# Account service the Google sign-in is bridged to. This is what makes the
# address the same one on Aurvania and OURO — only change it for testing.
AURVANIA_API=https://aurvania.quest

# Hostinger terminates TLS in front of the app, so set this to 1 for the rate
# limiter to see real client IPs instead of the proxy's.
TRUST_PROXY_HOPS=1

# --- build-time (baked into frontend/dist by `npm run build`) ---
VITE_ORDERBOOK_ADDRESS=
VITE_KOINOS_RPC=https://api.koinos.io
VITE_KOINOS_NETWORK=mainnet
