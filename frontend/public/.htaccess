# Redirect the retired subdomain (trade.koinoskit.site) to the new one
# (app.tradekoinos.com), preserving the path and query string.
#
# The condition matters: app.tradekoinos.com and trade.koinoskit.site share
# this same web root, so the rule must fire ONLY for the old host — otherwise
# app.tradekoinos.com would redirect to itself in a loop. The RewriteCond
# below scopes the redirect to the old host, leaving the new host untouched.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(www\.)?trade\.koinoskit\.site$ [NC]
  RewriteRule ^ https://app.tradekoinos.com%{REQUEST_URI} [R=301,L]
</IfModule>

# Security headers. The app is a static bundle now (no server to set these),
# so they live here. A Google sign-in gives this page a signing SESSION —
# never a key — but a strict CSP still matters: it shrinks what an injected
# script could do in the window a session is live.
#
# The bundle has no inline <script>, so script-src stays strict; React sets
# inline style attributes, so style-src keeps 'unsafe-inline'. connect-src is
# broad because the Koinos RPC/REST endpoint is chosen at build time and may be
# any https host (usekoinos.com is reached the same way). The accounts.google.com
# allowances are what Google Identity Services + One Tap need (its script, its
# button/One-Tap iframe, and its injected styles).
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
</IfModule>
