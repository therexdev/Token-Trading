# Address of the deployed orderbook contract (required)
VITE_ORDERBOOK_ADDRESS=

# Koinos JSON-RPC endpoint
VITE_KOINOS_RPC=https://api.koinos.io

# Network label shown in the UI: mainnet | harbinger
VITE_KOINOS_NETWORK=mainnet

# Bio Wallet relay used for QR connection and passkey signing
VITE_BIO_WALLET_API=https://wallet.usekoinos.com
