# Address of the deployed orderbook contract (required)
VITE_ORDERBOOK_ADDRESS=

# Address of the deployed launchpad contract (optional; without it the app
# discovers the address at runtime from usekoinos' /api/signer-config).
# Mainnet deployment: 13akLV3xQZdRjdQ2ANYo7cvSsD8qfBZReV
VITE_LAUNCHPAD_ADDRESS=

# Default gateway: Google sign-in, server-side signing, token minting.
# Override for another gateway; explicitly empty disables these services.
VITE_SIGNER_API=https://usekoinos.com

# Koinos JSON-RPC endpoints, comma-separated (extras are failover)
VITE_KOINOS_RPC=https://api.koinos.io,https://api.koinosblocks.com

# Network label shown in the UI: mainnet | harbinger
VITE_KOINOS_NETWORK=mainnet

# KOIN Vault relay used for QR connection and passkey signing
VITE_BIO_WALLET_API=https://koinvault.app
