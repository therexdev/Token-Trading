{
    "methods": {
        "create_launch": {
            "argument": "launchpad.create_launch_arguments",
            "return": "launchpad.create_launch_result",
            "description": "Create a launch. The creator escrows for_sale_amount + locked_amount of the token in this call (creator authority required). FIXED mode needs a positive price; POOL mode a zero price. A launch below its soft cap at the end is canceled and refunded.",
            "entry-point": "0xc6613e29",
            "read-only": false
        },
        "contribute": {
            "argument": "launchpad.contribute_arguments",
            "return": "launchpad.contribute_result",
            "description": "Buy into a live launch with KOIN (buyer authority required). FIXED mode: pulls exactly the cost of the tokens granted (partially filling the last buy); POOL mode: accepts KOIN up to the hard cap.",
            "entry-point": "0x8aa73cb6",
            "read-only": false
        },
        "finalize": {
            "argument": "launchpad.finalize_arguments",
            "return": "launchpad.finalize_result",
            "description": "Settle a launch once its end time has passed (or a FIXED launch has sold out). Success: KOIN to the creator, unsold tokens returned or burned, payouts open. Below soft cap: all escrowed tokens back to the creator, refunds open. Callable by anyone.",
            "entry-point": "0xc298bcd3",
            "read-only": false
        },
        "process": {
            "argument": "launchpad.process_arguments",
            "return": "launchpad.process_result",
            "description": "Run one batch of payouts (DISTRIBUTING) or refunds (REFUNDING), at most `limit` buyers per call (default 20, max 30). Callable by anyone; call repeatedly until the launch reports COMPLETED or CANCELED.",
            "entry-point": "0x19ed40bf",
            "read-only": false
        },
        "claim_locked": {
            "argument": "launchpad.claim_locked_arguments",
            "return": "launchpad.claim_locked_result",
            "description": "Deliver a completed launch's locked tokens to its creator once the unlock time has passed. Callable by anyone; the tokens always go to the creator.",
            "entry-point": "0xd6595230",
            "read-only": false
        },
        "provide_liquidity": {
            "argument": "launchpad.provide_liquidity_arguments",
            "return": "launchpad.provide_liquidity_result",
            "description": "Pair the held-back KOIN with the escrowed liquidity tokens on KoinDX (creates the pair if needed) and lock the LP tokens here until lp_unlock_time. Callable by anyone once a launch with liquidity settles; retryable - a failed KoinDX call changes nothing.",
            "entry-point": "0x27a28ddf",
            "read-only": false
        },
        "claim_liquidity": {
            "argument": "launchpad.claim_liquidity_arguments",
            "return": "launchpad.claim_liquidity_result",
            "description": "Deliver a launch's unlocked KoinDX LP tokens to its creator once lp_unlock_time has passed. Callable by anyone; the destination is always the creator.",
            "entry-point": "0x7dbff552",
            "read-only": false
        },
        "reclaim_liquidity": {
            "argument": "launchpad.reclaim_liquidity_arguments",
            "return": "launchpad.reclaim_liquidity_result",
            "description": "Creator escape hatch: if providing liquidity has kept failing for 7 days past the sale end, reclaim the earmarked KOIN + tokens (creator authority). The launch page shows this state to buyers.",
            "entry-point": "0x115ceef0",
            "read-only": false
        },
        "get_launches": {
            "argument": "launchpad.get_launches_arguments",
            "return": "launchpad.get_launches_result",
            "description": "List launches by ascending id: ids strictly greater than `start`, up to `limit` (default 50, max 100)",
            "entry-point": "0xd3c1d94e",
            "read-only": true
        },
        "get_launch": {
            "argument": "launchpad.get_launch_arguments",
            "return": "launchpad.get_launch_result",
            "description": "Get one launch by id",
            "entry-point": "0xdac82e4f",
            "read-only": true
        },
        "get_contribution": {
            "argument": "launchpad.get_contribution_arguments",
            "return": "launchpad.get_contribution_result",
            "description": "Get one account's contribution to a launch",
            "entry-point": "0x22680fa9",
            "read-only": true
        },
        "get_buyers": {
            "argument": "launchpad.get_buyers_arguments",
            "return": "launchpad.get_buyers_result",
            "description": "List a launch's contributions in batch order: seq >= start, up to `limit` (default 50, max 100)",
            "entry-point": "0x753886bd",
            "read-only": true
        }
    },
    "types": ""
}